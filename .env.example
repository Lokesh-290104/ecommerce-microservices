# Copy to .env to override the local dev defaults used by docker-compose.yml.
# Passwords are set once, when the MySQL volume is first created. After changing one here,
# recreate the volume (docker compose down -v), or mysql stays unhealthy and nothing starts.
# Compose expands $ inside these values: write a literal $ as $$ (pa$$word means pa$word).
MYSQL_ROOT_PASSWORD=root_dev_pw
MYSQL_HOST_PORT=3307
USER_SVC_DB_PASSWORD=user_svc_dev_pw
PRODUCT_SVC_DB_PASSWORD=product_svc_dev_pw
ORDER_SVC_DB_PASSWORD=order_svc_dev_pw
PAYMENT_SVC_DB_PASSWORD=payment_svc_dev_pw
